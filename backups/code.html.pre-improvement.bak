ownload PDF ↗</span></a></div></section>
<!-- Interactive JavaScript for Repository Filtering and Micro-interactions -->
<script>
    (function () {
      const filterButtons = document.querySelectorAll('.repo-filter-btn');
      const repoCards = document.querySelectorAll('.repo-item');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', function () {
          const filter = this.getAttribute('data-filter');

          // Toggle Active Button Styles
          filterButtons.forEach(b => {
            b.classList.remove('bg-primary', 'text-on-primary');
            b.classList.add('bg-surface-container-high', 'text-on-surface-variant');
          });
          this.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
          this.classList.add('bg-primary', 'text-on-primary');

          // Filter Repos
          repoCards.forEach(card => {
            const lang = card.getAttribute('data-lang');
            if (filter === 'all' || lang === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    })();
  </script>
