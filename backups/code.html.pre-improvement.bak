"space-sm":"0.5rem","margin-sm":"1rem","space-md":"1rem","gutter-lg":"2rem","space-xl":"2.5rem","margin-lg":"3rem","space-lg":"1.5rem"},"fontFamily":{"label-sm":["JetBrains Mono"],"body-md":["Inter"],"label-lg":["JetBrains Mono"],"headline-md":["Geist"],"body-lg":["Inter"],"headline-xl":["Geist"],"headline-lg-mobile":["Geist"],"headline-xl-mobile":["Geist"],"headline-lg":["Geist"],"label-md":["JetBrains Mono"],"headline-sm":["Geist"],"body-sm":["Inter"]},"fontSize":{"label-sm":["11px",{"lineHeight":"14px","letterSpacing":"0.02em","fontWeight":"400"}],"body-md":["14px",{"lineHeight":"22px","letterSpacing":"0em","fontWeight":"400"}],"label-lg":["14px",{"lineHeight":"20px","letterSpacing":"-0.01em","fontWeight":"500"}],"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.015em","fontWeight":"500"}],"body-lg":["16px",{"lineHeight":"26px","letterSpacing":"-0.005em","fontWeight":"400"}],"headline-xl":["48px",{"lineHeight":"56px","letterSpacing":"-0.03em","fontWeight":"600"}],"headline-lg-mobile":["24px",{"lineHeight":"32px","letterSpacing":"-0.015em","fontWeight":"600"}],"headline-xl-mobile":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"600"}],"headline-lg":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"600"}],"label-md":["12px",{"lineHeight":"16px","letterSpacing":"0em","fontWeight":"500"}],"headline-sm":["18px",{"lineHeight":"26px","letterSpacing":"-0.01em","fontWeight":"500"}],"body-sm":["13px",{"lineHeight":"18px","letterSpacing":"0em","fontWeight":"400"}]}}}}</script></head><body class="bg-surface font-body-md text-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary-container min-h-screen flex flex-col justify-between"><header class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"><div class="h-16 max-w-7xl mx-auto px-margin md:px-margin-lg flex items-center justify-between gap-space-md"><div class="flex items-center gap-space-md"><a class="flex items-center gap-space-xs group" href="#"><span class="font-headline-sm text-headline-sm text-primary font-bold tracking-tight">Andreas TDP</span><span class="font-label-sm text-label-sm text-outline">/</span><span class="font-body-sm text-body-sm text-on-surface-variant">Portfolio</span></a><div class="hidden sm:flex items-center gap-space-xs pl-space-sm py-space-xs pr-space-md bg-surface-container rounded-full"><span class="relative flex h-2 w-2 ml-space-xs"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-secondary"></span></span><span class="font-label-sm text-label-sm text-secondary font-medium">Available for Internships</span></div></div><nav class="hidden md:flex items-center gap-gutter"><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#about">About</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#projects">Projects</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#experience">Experience</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#repositories">Repositories</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#contact">Contact</a></nav><div class="flex items-center gap-space-sm"><a class="inline-flex items-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-md py-space-xs rounded-lg font-label-sm text-label-sm font-medium transition-all shadow-sm" href="#contact"><span class="">Get in Touch</span><span class="material-symbols-outlined text-[14px]">arrow_forward</span></a></div></div></header><main class="w-full pt-16 bg-surface flex-1 max-w-7xl mx-auto px-margin md:px-margin-lg"><div class="flex flex-col w-full">
<!-- SECTION 1: HERO & ABOUT -->
<section class="relative pt-space-xl pb-space-lg" id="about"><div class="relative grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-center py-space-md"><div class="lg:col-span-8 flex flex-col gap-space-md"><div class="inline-flex items-center gap-space-sm bg-surface-container-low px-space-md py-space-xs rounded-full w-fit"><span class="w-2 h-2 rounded-full bg-secondary"></span><span class="font-label-sm text-label-sm text-secondary font-medium tracking-wide uppercase">Network Technology &amp; Cloud Student</span></div><div class="flex flex-col gap-space-xs"><h1 class="font-headline-xl text-headline-xl text-on-surface font-semibold tracking-tight">Andreas Tri Dewa Putra</h1><p class="font-headline-sm text-headline-sm text-primary font-medium">Computer Science Student at BINUS University specializing in Network Technology</p></div><p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">Computer Science student at BINUS University specializing in Network Technology, with hands-on experience in cloud infrastructure, networking, cybersecurity, automation, and system programming. Experienced in developing academic and technical projects using Azure, Cisco, Docker, Terraform, Linux, Go, and Python.</p><div class="flex flex-wrap items-center gap-space-xs pt-space-xs"><span class="px-space-md py-space-xs bg-surface-container rounded-full font-label-sm text-label-sm text-on-surface font-medium">Networking</span><span class="px-space-md py-space-xs bg-surface-container rounded-full font-label-sm text-label-sm text-on-surface font-medium">Cloud Infrastructure</span><span class="px-space-md py-space-xs bg-surface-container rounded-full font-label-sm text-label-sm text-on-surface font-medium">Cybersecurity</span><span class="px-space-md py-space-xs bg-surface-container rounded-full font-label-sm text-label-sm text-on-surface font-medium">Network Automation</span><span class="px-space-md py-space-xs bg-surface-container rounded-full font-label-sm text-label-sm text-on-surface font-medium">System Programming</span></div><div class="flex flex-wrap items-center gap-space-md pt-space-sm"><a class="inline-flex items-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md px-space-lg py-space-sm rounded-lg transition-all shadow-sm" href="#contact"><span class="material-symbols-outlined text-[16px]">description</span><span class="">View My CV</span></a><a class="inline-flex items-center gap-space-xs bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md px-space-lg py-space-sm rounded-lg transition-all" href="https://github.com/andreas-tdp" rel="noopener noreferrer" target="_blank"><span class="material-symbols-outlined text-[16px] text-tertiary">code</span><span class="">GitHub Profile</span><span class="material-symbols-outlined text-[14px] text-outline">north_east</span></a></div></div><div class="lg:col-span-4 flex flex-col gap-space-md"><div class="bg-surface-container-low p-space-lg rounded-xl border border-surface-container-high flex flex-col gap-space-md"><div class="flex items-center gap-space-sm"><div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-primary"><span class="material-symbols-outlined text-[20px]">school</span></div><div><h4 class="font-headline-sm text-headline-sm text-on-surface font-medium">BINUS University</h4><p class="font-body-sm text-body-sm text-on-surface-variant">Computer Science Undergraduate</p></div></div><div class="flex flex-col gap-space-xs pt-space-xs"><div class="flex justify-between items-center font-label-sm text-label-sm"><span class="text-outline">Specialization:</span><span class="text-on-surface font-medium">Network Technology</span></div><div class="flex justify-between items-center font-label-sm text-label-sm"><span class="text-outline">Degree:</span><span class="text-on-surface font-medium">Bachelor of Computer Science</span></div><div class="flex justify-between items-center font-label-sm text-label-sm"><span class="text-outline">Status:</span><span class="text-secondary font-medium">Open to Internship</span></div></div></div><div class="bg-surface-container-low p-space-md rounded-xl flex items-center justify-between gap-space-sm"><div class="flex items-center gap-space-xs text-on-surface font-label-sm text-label-sm"><span class="material-symbols-outlined text-secondary text-[18px]">verified</span><span class="">Core Stack: Azure, Cisco, Docker, Linux, Go, Python</span></div></div></div></div></section>
<!-- SECTION 2: FEATURED PROJECTS -->
<section class="py-space-xl" id="projects"><div class="flex flex-col gap-space-lg"><div class="flex flex-col gap-space-xs"><div class="flex items-center gap-space-xs"><span class="font-label-sm text-label-sm text-secondary font-mono uppercase">01 // TECHNICAL WORK</span><span class="w-8 h-[1px] bg-secondary/40"></span></div><h2 class="font-headline-lg text-headline-lg text-on-surface font-semibold tracking-tight">Featured Projects</h2><p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">Academic and technical implementations spanning cloud architecture, network simulation, system programming, and machine learning.</p></div><div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg"><div class="bg-surface-container-low rounded-xl p-space-lg flex flex-col justify-between gap-space-md hover:bg-surface-container transition-all"><div class="flex flex-col gap-space-sm"><div class="flex items-center justify-between"><span class="font-label-sm text-label-sm text-primary font-mono">Cloud Infrastructure</span><a class="text-outline hover:text-primary transition-colors flex items-center gap-1 font-label-sm text-label-sm" href="https://github.com/andreas-tdp" rel="noopener noreferrer" target="_blank"><span class="material-symbols-outlined text-[16px]">code</span><span class="">Repo</span></a></div><h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Cloud Infrastructure &amp; Deployment</h3><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Multi-region container cluster orchestration, declarative Infrastructure-as-Code (IaC) provisioning, and automated continuous deployment workflows across cloud virtual machines.</p><ul class="flex flex-col gap-space-xs font-body-sm text-body-sm text-on-surface-variant pt-space-xs"><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Virtual networks, subnets, and security group isolation.</span></li><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Multi-stage lightweight Docker image builds.</span></li><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Automated rollouts and health monitoring.</span></li></ul></div><div class="flex flex-wrap items-center gap-space-xs pt-space-xs"><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Azure</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Docker</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Terraform</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Ansible</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Linux</span></div></div><div class="bg-surface-container-low rounded-xl p-space-lg flex flex-col justify-between gap-space-md hover:bg-surface-container transition-all"><div class="flex flex-col gap-space-sm"><div class="flex items-center justify-between"><span class="font-label-sm text-label-sm text-secondary font-mono">System Programming</span><a class="text-outline hover:text-primary transition-colors flex items-center gap-1 font-label-sm text-label-sm" href="https://github.com/andreas-tdp" rel="noopener noreferrer" target="_blank"><span class="material-symbols-outlined text-[16px]">code</span><span class="">Repo</span></a></div><h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Network System Programming</h3><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Concurrent TCP client-server applications and proxy systems built using Go and native Linux sockets, focusing on connection management and protocol implementation.</p><ul class="flex flex-col gap-space-xs font-body-sm text-body-sm text-on-surface-variant pt-space-xs"><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Non-blocking I/O multiplexing and connection pooling.</span></li><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Low-latency buffering and reverse proxy routing.</span></li><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Clean protocol parsing and diagnostic telemetry.</span></li></ul></div><div class="flex flex-wrap items-center gap-space-xs pt-space-xs"><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Go (Golang)</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Linux Sockets</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">TCP/IP</span></div></div><div class="bg-surface-container-low rounded-xl p-space-lg flex flex-col justify-between gap-space-md hover:bg-surface-container transition-all"><div class="flex flex-col gap-space-sm"><div class="flex items-center justify-between"><span class="font-label-sm text-label-sm text-tertiary font-mono">Machine Learning</span><a class="text-outline hover:text-primary transition-colors flex items-center gap-1 font-label-sm text-label-sm" href="https://github.com/andreas-tdp" rel="noopener noreferrer" target="_blank"><span class="material-symbols-outlined text-[16px]">code</span><span class="">Repo</span></a></div><h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">AI &amp; Machine Learning</h3><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Lightweight convolutional image classification pipeline incorporating dataset preparation, model training, fine-tuning, and interactive deployment.</p><ul class="flex flex-col gap-space-xs font-body-sm text-body-sm text-on-surface-variant pt-space-xs"><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Transfer learning and optimization with MobileNetV2.</span></li><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Interactive web inferencing interface built with Streamlit.</span></li><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Dataset augmentation and validation scoring.</span></li></ul></div><div class="flex flex-wrap items-center gap-space-xs pt-space-xs"><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Python</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">TensorFlow</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">MobileNetV2</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Streamlit</span></div></div><div class="bg-surface-container-low rounded-xl p-space-lg flex flex-col justify-between gap-space-md hover:bg-surface-container transition-all"><div class="flex flex-col gap-space-sm"><div class="flex items-center justify-between"><span class="font-label-sm text-label-sm text-primary font-mono">Infrastructure Automation</span><a class="text-outline hover:text-primary transition-colors flex items-center gap-1 font-label-sm text-label-sm" href="https://github.com/andreas-tdp" rel="noopener noreferrer" target="_blank"><span class="material-symbols-outlined text-[16px]">code</span><span class="">Repo</span></a></div><h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Network Automation</h3><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Declarative network configuration orchestration and simulation on Cisco devices with automated drift verification and topology testing.</p><ul class="flex flex-col gap-space-xs font-body-sm text-body-sm text-on-surface-variant pt-space-xs"><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Network simulation using Cisco Packet Tracer and GNS3.</span></li><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Ansible playbooks for automated switch and router provisioning.</span></li><li class="flex items-start gap-space-xs"><span class="text-secondary">•</span><span class="">Python scripts for configuration audit and verification.</span></li></ul></div><div class="flex flex-wrap items-center gap-space-xs pt-space-xs"><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Ansible</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Cisco</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Python</span><span class="px-space-xs py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-outline">Packet Tracer</span></div></div></div></div></section>
<!-- SECTION 3: EXPERIENCE & ORGANIZATIONS -->
<section class="py-space-xl" id="experience"><div class="flex flex-col gap-space-lg"><div class="flex flex-col gap-space-xs"><div class="flex items-center gap-space-xs"><span class="font-label-sm text-label-sm text-secondary font-mono uppercase">02 // LEADERSHIP &amp; ORGANIZATIONS</span><span class="w-8 h-[1px] bg-secondary/40"></span></div><h2 class="font-headline-lg text-headline-lg text-on-surface font-semibold tracking-tight">Experience &amp; Leadership</h2><p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">Active committee coordination, technical logistics support, and community education leadership across academic initiatives.</p></div><div class="flex flex-col gap-space-md"><div class="bg-surface-container-low p-space-lg rounded-xl flex flex-col gap-space-xs hover:bg-surface-container transition-all"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs"><h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">BINUS Entrepreneur Center — Committee Member</h3><span class="font-label-sm text-label-sm text-tertiary bg-surface-container-high px-space-sm py-0.5 rounded font-mono w-fit">FYP 2025/2026 &amp; 2026/2027</span></div><div class="flex items-center gap-space-xs"><span class="font-label-sm text-label-sm text-primary font-medium">IT Support &amp; Event Operations</span><span class="font-label-sm text-label-sm text-outline">•</span><span class="font-label-sm text-label-sm text-on-surface-variant">BINUS University</span></div><p class="font-body-md text-body-md text-on-surface-variant pt-space-xs leading-relaxed">Provided reliable IT support across multiple cohorts, assisted student participants with platform login and technical troubleshooting, coordinated event activities, and delivered formal opening remarks for orientation programs.</p></div><div class="bg-surface-container-low p-space-lg rounded-xl flex flex-col gap-space-xs hover:bg-surface-container transition-all"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs"><h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">BINUS Festival — Committee Member</h3><span class="font-label-sm text-label-sm text-secondary bg-surface-container-high px-space-sm py-0.5 rounded font-mono w-fit">2025/2026 Odd &amp; Even Semesters</span></div><div class="flex items-center gap-space-xs"><span class="font-label-sm text-label-sm text-primary font-medium">Logistics &amp; Participant Data Operations</span><span class="font-label-sm text-label-sm text-outline">•</span><span class="font-label-sm text-label-sm text-on-surface-variant">Campus Operations</span></div><p class="font-body-md text-body-md text-on-surface-variant pt-space-xs leading-relaxed">Managed and recorded attendee check-in and attendance data, ensured smooth operations at event stations, and assisted in festival scheduling and logistical execution across large-scale campus events.</p></div><div class="bg-surface-container-low p-space-lg rounded-xl flex flex-col gap-space-xs hover:bg-surface-container transition-all"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs"><h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Mentoring Team Leader — TFI Teach For Indonesia</h3><span class="font-label-sm text-label-sm text-tertiary bg-surface-container-high px-space-sm py-0.5 rounded font-mono w-fit">PAUD Baiturrahman Community Project</span></div><div class="flex items-center gap-space-xs"><span class="font-label-sm text-label-sm text-primary font-medium">Team Lead &amp; Curriculum Coordinator</span><span class="font-label-sm text-label-sm text-outline">•</span><span class="font-label-sm text-label-sm text-on-surface-variant">Social Impact &amp; Education</span></div><p class="font-body-md text-body-md text-on-surface-variant pt-space-xs leading-relaxed">Led a team of 5 members delivering 5 comprehensive teaching sessions over 3 weeks. Coordinated member task allocations, scheduling, interactive learning curriculum execution, and stakeholder communication.</p></div></div></div></section>
<!-- SECTION 4: GITHUB REPOSITORIES TELEMETRY -->
